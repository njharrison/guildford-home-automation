{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guildford-home-automation",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "njharrison@gmail.com"
    }
  ]
}
